<%@ CodeTemplate Language="C#" TargetLanguage="C#" %>
<%@ Assembly Name="CodeSmith.Engine" %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="CodeSmith.Engine" %>
<%@ Import Namespace="SchemaExplorer" %>

<%@ Property Name="DbTable" Type="SchemaExplorer.TableSchema" %>

<script runat="template">
    public string GetPropertyType(ColumnSchema column)
    {
        DbType dbType = column.DataType;
        string typeName = "";
        
        if (dbType == DbType.Int32)
        {
            typeName = "int";
        }
        
        if (dbType == DbType.Int64)
        {
            typeName =  "long";
        }
        
        if (dbType == DbType.String)
        {
            typeName =  "string";
        }

        if (dbType == DbType.DateTime)
        {
            typeName =  "DateTime";
        }
        
        if (string.IsNullOrWhiteSpace(typeName) == true)
        {
            typeName = "unknow";
        }
        
        if (column.AllowDBNull == true)
        {
            typeName = typeName + "?";
        }

        return typeName;
    }
</script>
using Core;

namespace Domain;

/// <summary>
/// <%= DbTable.Description %>
/// </summary>
public class <%= StringUtil.ToPascalCase(DbTable.Name.Substring(3)) %>Entity : Entity
{
<% 
var columnList = DbTable.Columns
        .Where(e => e.Name != "id" && e.Name != "create_time" && e.Name != "update_time")
        .ToList();
foreach (ColumnSchema column in columnList)
{ 
%>
    /// <summary>
    /// <%= column.Description %>
    /// </summary>
    public <%= GetPropertyType(column) %> <%= StringUtil.ToPascalCase(column.Name) %> { get; set; }<% if (column.DataType == DbType.String && column.AllowDBNull == false) { %> = ""; <% } %>

<%
}
%>
}