<%@ CodeTemplate Language="C#" TargetLanguage="C#" %>
<%@ Assembly Name="CodeSmith.Engine" %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="CodeSmith.Engine" %>
<%@ Import Namespace="SchemaExplorer" %>

<%@ Property Name="DbTable" Type="SchemaExplorer.TableSchema" %>

<script runat="template">
    public string GetEntityName()
    {
        return StringUtil.ToPascalCase(DbTable.Name.Substring(3));
    }
</script>
using Core;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace Domain;

public class <%= GetEntityName() %>EntityMap : IEntityTypeConfiguration<<%= GetEntityName()%>Entity>
{
    public void Configure(EntityTypeBuilder<<%= GetEntityName() %>Entity> builder)
    {
        builder.ToTable("<%= DbTable.Name %>");

        EntityMap.Configure(builder);

<%
var columnList = DbTable.Columns
        .Where(e => e.Name != "id" && e.Name != "create_time" && e.Name != "update_time")
        .ToList();
foreach (ColumnSchema column in columnList)
{
%>
        builder.Property(e => e.<%= StringUtil.ToPascalCase(column.Name) %>)
            .HasColumnName("<%= column.Name %>")<% if (column.DataType == DbType.String) { %>
            .HasMaxLength(<%= column.Size %>) <% } %>
            .IsRequired(<% if (column.AllowDBNull) { %>false<% } else {%>true<% } %>);

<%
}
%>
    }
}