<?xml version="1.0" encoding="utf-8"?>

<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" autoReload="true">
    <extensions>
        <add assembly="NLog.Web.AspNetCore" />
    </extensions>
    <targets>
        <target xsi:type="File"
                name="file"
                fileName="${basedir}/logs/log-${shortdate}.log"
                keepFileOpen="true"
                encoding="utf-8"
                maxArchiveFiles="100"
                archiveAboveSize="10240000"
                archiveEvery="Day"
                layout="${longdate}|${level:uppercase=true}|${logger}${newline}${uppercase:${aspnet-request-method}} ${aspnet-mvc-controller}.${aspnet-mvc-action}${newline}${uppercase:${aspnet-request-method}} ${aspnet-request-url}${newline}${callsite} line ${callsite-linenumber}${newline}${message}${newline}${exception}" />

        <target xsi:type="File"
                name="fileError"
                fileName="${basedir}/logs/log-${shortdate}-error.log"
                keepFileOpen="true"
                encoding="utf-8"
                maxArchiveFiles="100"
                archiveAboveSize="10240000"
                archiveEvery="Day"
                layout="${longdate}|${level:uppercase=true}|${logger}${newline}${uppercase:${aspnet-request-method}} ${aspnet-mvc-controller}.${aspnet-mvc-action}${newline}${uppercase:${aspnet-request-method}} ${aspnet-request-url}${newline}${callsite} line ${callsite-linenumber}${newline}${message}${newline}${exception}" />
    </targets>
    <rules>
        <logger name="Microsoft.*" minlevel="Error" writeTo="fileError,file" final="true" />
        <logger name="NHibernate.*" minlevel="Error" writeTo="fileError,file" final="true" />
        <logger name="*" minlevel="Warn" writeTo="file" />
        <logger name="*" minlevel="Error" writeTo="fileError,file" />
    </rules>
</nlog>